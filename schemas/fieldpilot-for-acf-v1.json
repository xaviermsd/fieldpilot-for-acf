{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://fieldpilot.dev/schemas/v1.json",
    "title": "FieldPilot for ACF patch payload",
    "description": "A configuration patch for an Advanced Custom Fields field group. Designed to be generated by an AI or written by hand. The engine applies only what this document names; anything not mentioned is left exactly as it is.",
    "type": "object",
    "required": [ "operation" ],
    "additionalProperties": false,
    "properties": {
        "version": {
            "type": "string",
            "description": "Schema version. Omit and 1.0 is assumed.",
            "default": "1.0",
            "examples": [ "1.0" ]
        },
        "operation": {
            "type": "string",
            "description": "What to do. Unknown operations are rejected rather than guessed.",
            "enum": [ "create", "add", "update", "delete", "move", "merge", "sync", "replace" ]
        },
        "target": {
            "description": "Where to act. Required for every operation except create.",
            "oneOf": [
                { "type": "string", "description": "Field group title or group_xxx key." },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "field_group": {
                            "type": "string",
                            "description": "Field group title, or its group_xxxxx key. A key is unambiguous and preferred."
                        },
                        "path": {
                            "description": "Human path from the group root to the container being targeted, by field label or name.",
                            "oneOf": [
                                { "type": "array", "items": { "type": "string" } },
                                { "type": "string", "description": "Also accepts \"Parent > Child\" or \"parent.child\"." }
                            ]
                        },
                        "field": {
                            "type": "string",
                            "description": "A specific field, by key, name or label."
                        },
                        "layout": {
                            "type": "string",
                            "description": "A flexible content layout, by key, name or label."
                        }
                    },
                    "required": [ "field_group" ]
                }
            ]
        },
        "field_group": {
            "type": "object",
            "description": "A whole field group definition. Used by create, replace and sync.",
            "properties": {
                "title": { "type": "string", "minLength": 1 },
                "fields": { "type": "array", "items": { "$ref": "#/definitions/field" } },
                "location": { "type": "array", "description": "ACF location rule groups." },
                "menu_order": { "type": "integer" },
                "position": { "type": "string", "enum": [ "acf_after_title", "normal", "side" ] },
                "style": { "type": "string", "enum": [ "default", "seamless" ] },
                "label_placement": { "type": "string", "enum": [ "top", "left" ] },
                "instruction_placement": { "type": "string", "enum": [ "label", "field" ] },
                "hide_on_screen": { "type": "array", "items": { "type": "string" } },
                "active": { "type": "boolean" },
                "description": { "type": "string" },
                "show_in_rest": { "type": "boolean" }
            },
            "required": [ "title" ]
        },
        "changes": {
            "description": "Settings to change on existing fields. ONLY the settings named here are touched.",
            "oneOf": [
                {
                    "type": "object",
                    "description": "Keyed by field name, key or label.",
                    "additionalProperties": { "type": "object" }
                },
                {
                    "type": "array",
                    "description": "List form; each item names its own field.",
                    "items": {
                        "type": "object",
                        "required": [ "field" ],
                        "properties": { "field": { "type": "string" } }
                    }
                }
            ]
        },
        "add": {
            "type": "array",
            "description": "Fields to insert into the target.",
            "items": { "$ref": "#/definitions/field" }
        },
        "add_layouts": {
            "type": "array",
            "description": "Flexible content layouts to insert into the target field.",
            "items": { "$ref": "#/definitions/layout" }
        },
        "delete": {
            "type": "array",
            "description": "Fields to remove, by name, key or label. Destructive: requires confirmation.",
            "items": { "type": "string" }
        },
        "moves": {
            "type": "array",
            "description": "Relocate existing fields.",
            "items": {
                "type": "object",
                "required": [ "field" ],
                "additionalProperties": false,
                "properties": {
                    "field": { "type": "string" },
                    "to": { "type": "object", "description": "Destination container, same shape as target." },
                    "position": { "type": "string", "enum": [ "first", "last", "before", "after" ], "default": "last" },
                    "anchor": { "type": "string", "description": "Sibling to position against. Required for before/after." }
                }
            }
        },
        "group_changes": {
            "type": "object",
            "description": "Field group settings to change, such as title or location."
        },
        "options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "confirm": {
                    "description": "Explicit confirmation for destructive changes.",
                    "oneOf": [ { "type": "boolean" }, { "type": "object" } ]
                },
                "resolutions": {
                    "type": "object",
                    "description": "Conflict id => chosen option id.",
                    "additionalProperties": { "type": "string" }
                },
                "skip_data_probe": {
                    "type": "boolean",
                    "description": "Skip the content-detection scan. The preview then reports content status as unknown rather than as none.",
                    "default": false
                }
            }
        }
    },
    "definitions": {
        "field": {
            "type": "object",
            "description": "A field definition. Per-type settings are validated against ACF's own shipped schemas at import time, so anything ACF accepts is accepted here.",
            "required": [ "type" ],
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^[a-z_][a-z0-9_]*$",
                    "description": "The meta key content is stored under. Changing it on an existing field orphans that content."
                },
                "label": { "type": "string" },
                "type": { "type": "string", "description": "An ACF field type registered on the target site." },
                "key": {
                    "type": "string",
                    "pattern": "^field_[a-z0-9]+$",
                    "description": "Do not supply this for new fields - the engine generates it. Existing keys are never regenerated."
                },
                "instructions": { "type": "string" },
                "required": { "type": [ "boolean", "integer" ] },
                "default_value": {},
                "placeholder": { "type": "string" },
                "wrapper": {
                    "type": "object",
                    "properties": {
                        "width": { "type": [ "string", "integer" ] },
                        "class": { "type": "string" },
                        "id": { "type": "string" }
                    }
                },
                "conditional_logic": { "type": [ "boolean", "array", "integer" ] },
                "choices": {
                    "description": "For select, checkbox, radio and button_group. An object of value => label, or a plain list.",
                    "type": [ "object", "array" ]
                },
                "sub_fields": {
                    "type": "array",
                    "description": "Children. Only for group and repeater.",
                    "items": { "$ref": "#/definitions/field" }
                },
                "layouts": {
                    "type": "array",
                    "description": "Only for flexible_content.",
                    "items": { "$ref": "#/definitions/layout" }
                }
            }
        },
        "layout": {
            "type": "object",
            "description": "A flexible content layout.",
            "required": [ "name" ],
            "properties": {
                "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
                "label": { "type": "string" },
                "display": { "type": "string", "enum": [ "table", "block", "row" ], "default": "block" },
                "min": { "type": [ "integer", "string" ] },
                "max": { "type": [ "integer", "string" ] },
                "sub_fields": { "type": "array", "items": { "$ref": "#/definitions/field" } }
            }
        }
    },
    "examples": [
        {
            "version": "1.0",
            "operation": "update",
            "target": { "field_group": "Property", "path": [ "Agent" ] },
            "changes": { "email": { "required": true } },
            "add": [ { "name": "whatsapp", "label": "WhatsApp", "type": "text" } ]
        }
    ]
}
